# Environment Configuration
PROJECT_NAME="AI Operations Assistant"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL with pgvector for Docker, SQLite for local dev)
# Docker: postgresql://postgres:postgrespassword@localhost:5432/ai_ops
# Local SQLite fallback: sqlite:///./ai_ops.db
DATABASE_URL=sqlite:///./ai_ops.db

# AI Provider Selection
# Options: "gemini" (default), "openai", or "demo"
LLM_PROVIDER=gemini

# Google Gemini Configuration (Primary Provider)
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="text-embedding-004"
EMBEDDING_DIMENSION=384

# OpenAI Configuration (Optional Secondary Provider)
OPENAI_API_KEY=""

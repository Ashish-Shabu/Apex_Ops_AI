# App Environment Configuration
PROJECT_NAME="AI Operations Assistant"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Database Configuration (PostgreSQL + pgvector)
# For local Docker: postgresql://postgres:postgrespassword@localhost:5432/ai_ops
# For SQLite (local dev/testing fallback): sqlite:///./ai_ops.db
DATABASE_URL=sqlite:///./ai_ops.db

# AI Provider Selection
# Options: "gemini" (default), "openai", or "demo"
LLM_PROVIDER=gemini

# Google Gemini Configuration (Primary Provider)
# Obtain key at: https://aistudio.google.com/
GEMINI_API_KEY=""
LLM_MODEL="gemini-2.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# Vector Dimension
# 384 for text-embedding-004 output_dimensionality (matches pgvector default & demo embeddings)
# 768 for text-embedding-004 native dimension
EMBEDDING_DIMENSION=384

# OpenAI Configuration (Optional Secondary Provider)
OPENAI_API_KEY=""
